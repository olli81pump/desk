:root {
  --bg: #07090d;
  --panel: #0e1218;
  --panel2: #141a22;
  --line: #1b222d;
  --line2: #283140;
  --text: #e9edf3;
  --muted: #8d97a9;
  --dim: #5a6477;
  --amber: #f5b53d;
  --cyan: #3fd5e6;
  --blue: #5d9bff;
  --green: #22d37f;
  --green-bg: rgba(34,211,127,.10);
  --red: #ff5468;
  --red-bg: rgba(255,84,104,.10);
  --orange: #ff8f45;
  --violet: #9b7bff;
  --brand: #22d37f;
  --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, "JetBrains Mono", Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", system-ui, sans-serif;
  --r: 12px;
  --tab-h: 60px;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bot: env(safe-area-inset-bottom, 0px);
  --safe-l: env(safe-area-inset-left, 0px);
  --safe-r: env(safe-area-inset-right, 0px);
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--sans);
  font-size: 14px; line-height: 1.35; min-height: 100%; -webkit-font-smoothing: antialiased; }
body { padding-left: var(--safe-l); padding-right: var(--safe-r); }
a { color: var(--cyan); text-decoration: none; }
button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
.num, .mono { font-family: var(--mono); font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
.pos-c { color: var(--green); } .neg-c { color: var(--red); } .mut { color: var(--muted); } .dimc { color: var(--dim); }
#app { max-width: 520px; margin: 0 auto; min-height: 100dvh;
  padding-bottom: calc(var(--tab-h) + var(--safe-bot) + 16px); }

/* ---------- status bar ---------- */
.sbar { position: sticky; top: 0; z-index: 10; background: rgba(5,6,8,.94);
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line); padding-top: var(--safe-top); }
.sbar .r1 { display: flex; align-items: center; gap: 8px; padding: 8px 12px 6px; }
.logo { font-family: var(--mono); font-weight: 700; font-size: 13px; letter-spacing: .12em; color: var(--amber); }
.logo b { color: var(--text); font-weight: 700; }
.mode { font-family: var(--mono); font-size: 11px; font-weight: 800; letter-spacing: .14em;
  padding: 3px 7px; border-radius: 3px; border: 1px solid; }
.mode.LIVE { color: #fff; background: #d71f36; border-color: #ff4d5e; box-shadow: 0 0 12px rgba(255,77,94,.45); }
.mode.LIVE::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%;
  background: #fff; margin-right: 5px; vertical-align: 1px; animation: blink 1.4s infinite; }
.mode.PAPER { color: var(--blue); background: rgba(91,157,255,.10); border-color: rgba(91,157,255,.45); }
@keyframes blink { 50% { opacity: .2; } }
.upd { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
.dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; background: var(--dim); flex: none; }
.dot.ok { background: var(--green); box-shadow: 0 0 6px rgba(25,210,122,.7); }
.dot.warn { background: var(--amber); }
.dot.bad { background: var(--red); box-shadow: 0 0 6px rgba(255,77,94,.7); }
.tick { display: grid; grid-template-columns: 1.15fr 1.15fr .6fr 1.3fr; border-top: 1px solid var(--line); }
.tick > div { padding: 5px 10px 6px; border-right: 1px solid var(--line); min-width: 0; }
.tick > div:last-child { border-right: 0; }
.lbl { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; color: var(--dim); text-transform: uppercase; white-space: nowrap; }
.tick .v { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hb { display: flex; gap: 4px; margin-top: 5px; }

/* ---------- layout ---------- */
.pad { padding: 10px 10px 0; }
.sec { display: flex; align-items: baseline; justify-content: space-between; margin: 16px 2px 6px; }
.sec h2 { margin: 0; font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .16em; color: var(--amber); text-transform: uppercase; }
.sec .aside { font-family: var(--mono); font-size: 11px; color: var(--dim); }
.sec:first-child { margin-top: 4px; }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; }
.panel + .panel { margin-top: 8px; }
.empty { padding: 18px 12px; text-align: center; color: var(--dim); font-family: var(--mono); font-size: 12px;
  border: 1px dashed var(--line2); border-radius: 6px; }
.error { padding: 14px; color: var(--red); background: var(--red-bg); border: 1px solid rgba(255,77,94,.35); border-radius: 6px; font-family: var(--mono); font-size: 12px; }
.note { padding: 9px 11px; border-radius: 6px; font-size: 12.5px; border: 1px solid rgba(255,176,0,.35);
  background: rgba(255,176,0,.07); color: #ffd27a; margin-bottom: 8px; }
.warnbox { margin-top: 8px; }

/* KPI grid */
.kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line);
  border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
.kpis.two { grid-template-columns: repeat(2, 1fr); }
.kpi { background: var(--panel); padding: 8px 10px 9px; min-width: 0; }
.kpi .v { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 16px; font-weight: 650; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kpi .v.big { font-size: 22px; }
.kpi .s { font-family: var(--mono); font-size: 10.5px; color: var(--muted); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* positions */
.posc { background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--line2); border-radius: 6px; padding: 9px 10px 10px; }
.posc.up { border-left-color: var(--green); } .posc.down { border-left-color: var(--red); }
.posc + .posc { margin-top: 8px; }
.ph { display: flex; align-items: flex-start; gap: 8px; }
.ph .nm { font-weight: 650; font-size: 15px; }
.ph .nm a { color: var(--text); }
.tag { font-family: var(--mono); font-size: 9.5px; font-weight: 700; letter-spacing: .1em; padding: 1px 5px; border-radius: 3px; border: 1px solid var(--line2); color: var(--muted); vertical-align: 2px; margin-left: 4px; }
.tag.LIVE { color: var(--red); border-color: rgba(255,77,94,.5); }
.tag.PAPER { color: var(--blue); border-color: rgba(91,157,255,.45); }
.tag.ok { color: var(--green); border-color: rgba(25,210,122,.45); }
.ph .pnl { margin-left: auto; text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; }
.ph .pnl .a { font-size: 18px; font-weight: 700; }
.ph .pnl .b { font-size: 11.5px; }
.grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px 8px; margin-top: 8px; }
.grid4 .v { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
canvas.mini { display: block; width: 100%; height: 86px; margin-top: 8px; background: #07090c; border: 1px solid var(--line); border-radius: 4px; }
canvas.big { display: block; width: 100%; height: 200px; background: #07090c; border: 1px solid var(--line); border-radius: 6px; }
canvas.chart2 { display: block; width: 100%; height: 170px; }
.acts { display: flex; gap: 8px; margin-top: 8px; }
.btn { flex: 1; display: inline-flex; justify-content: center; align-items: center; height: 38px; border-radius: 5px;
  font-family: var(--mono); font-weight: 700; font-size: 12.5px; letter-spacing: .04em; border: 1px solid var(--line2); color: var(--text); background: var(--panel2); }
.btn.sell { background: var(--red); border-color: var(--red); color: #fff; }
.btn.ghost { flex: 0 0 auto; padding: 0 14px; }
.tpbar { display: flex; gap: 6px; margin-top: 8px; }
.tpbar span { flex: 1; text-align: center; font-family: var(--mono); font-size: 10.5px; padding: 3px 0; border-radius: 3px; border: 1px solid var(--line2); color: var(--muted); }
.tpbar span.hit { color: var(--green); border-color: rgba(25,210,122,.5); background: var(--green-bg); }
.tpbar span.stop { color: var(--orange); border-color: rgba(255,138,61,.45); }

/* tape / rows */
.tape { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
.tr { display: grid; grid-template-columns: 40px 62px 1fr auto; gap: 8px; align-items: center; padding: 7px 10px; border-top: 1px solid var(--line); font-size: 12.5px; }
.tr:first-child { border-top: 0; }
.tr .t { font-family: var(--mono); font-size: 11px; color: var(--dim); }
.tr .k { font-family: var(--mono); font-size: 9.5px; font-weight: 700; letter-spacing: .08em; text-align: center; padding: 2px 0; border-radius: 3px; background: var(--panel2); color: var(--muted); border: 1px solid var(--line2); }
.tr .k.good { color: var(--green); border-color: rgba(25,210,122,.4); }
.tr .k.bad { color: var(--red); border-color: rgba(255,77,94,.4); }
.tr .k.kill { color: var(--dim); }
.tr .k.buy { color: var(--cyan); border-color: rgba(56,214,232,.4); }
.tr .m { min-width: 0; }
.tr .m .n { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tr .m .n a { color: var(--text); }
.tr .m .d { font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tr .r { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 12px; text-align: right; white-space: nowrap; }
.tr.kill .m .n a { color: var(--muted); }
.more { display: block; width: 100%; padding: 9px; font-family: var(--mono); font-size: 11.5px; color: var(--cyan); border-top: 1px solid var(--line); }

/* tables */
table.tb { width: 100%; border-collapse: collapse; font-size: 12px; }
.tb th { font-family: var(--mono); font-size: 9.5px; letter-spacing: .1em; color: var(--dim); text-align: left; font-weight: 600; padding: 7px 8px; border-bottom: 1px solid var(--line2); text-transform: uppercase; }
.tb td { padding: 7px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
.tb tr:last-child td { border-bottom: 0; }
.tb .rt { text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; }
.tb td.nm { max-width: 110px; overflow: hidden; text-overflow: ellipsis; }

/* bars */
.bars { padding: 6px 10px 8px; }
.bar { display: grid; grid-template-columns: 112px 1fr 64px; gap: 8px; align-items: center; padding: 4px 0; font-size: 12px; }
.bar .l { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--muted); }
.bar .track { height: 12px; background: #11151c; border-radius: 2px; overflow: hidden; }
.bar .fill { height: 100%; background: var(--cyan); border-radius: 2px; min-width: 1px; }
.bar .fill.g { background: var(--green); } .bar .fill.r { background: var(--red); } .bar .fill.a { background: var(--amber); } .bar .fill.o { background: var(--orange); } .bar .fill.b { background: var(--blue); }
.bar .x { font-family: var(--mono); font-variant-numeric: tabular-nums; text-align: right; font-size: 11.5px; }
.bar .x small { color: var(--dim); }
.chartbox { padding: 8px 8px 6px; }
.legend { display: flex; flex-wrap: wrap; gap: 12px; font-family: var(--mono); font-size: 10.5px; color: var(--muted); padding: 2px 10px 8px; }
.legend i { display: inline-block; width: 12px; height: 2px; margin-right: 5px; vertical-align: 3px; background: var(--cyan); }

/* segmented */
.seg { display: flex; border: 1px solid var(--line2); border-radius: 5px; overflow: hidden; margin-bottom: 8px; }
.seg button { flex: 1; padding: 7px 0; font-family: var(--mono); font-size: 11.5px; font-weight: 700; letter-spacing: .1em; color: var(--muted); border-right: 1px solid var(--line2); }
.seg button:last-child { border-right: 0; }
.seg button.on { background: var(--amber); color: #000; }

/* agents */
.agrid { display: grid; grid-template-columns: 1fr; gap: 8px; }
.ag { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 9px 10px 10px; }
.ag .h { display: flex; align-items: center; gap: 7px; }
.ag .h .n { font-family: var(--mono); font-weight: 700; letter-spacing: .1em; font-size: 12px; text-transform: uppercase; }
.ag .h .ic { width: 22px; height: 22px; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; background: var(--panel2); border: 1px solid var(--line2); font-size: 12px; }
.ag .h .age { margin-left: auto; font-family: var(--mono); font-size: 10.5px; color: var(--dim); display: flex; gap: 5px; align-items: center; }
.ag .big { font-family: var(--mono); font-size: 17px; font-weight: 650; margin-top: 6px; }
.ag .sub { color: var(--muted); font-size: 12px; }
.ag .rows { margin-top: 8px; border-top: 1px solid var(--line); }
.ag .rows .tr { padding-left: 0; padding-right: 0; grid-template-columns: 1fr auto; }
.pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.pill { font-family: var(--mono); font-size: 11px; padding: 3px 7px; border-radius: 3px; border: 1px solid var(--line2); color: var(--muted); }
.pill.stop { color: var(--red); border-color: rgba(255,77,94,.4); }
.pill.trail { color: var(--orange); border-color: rgba(255,138,61,.4); }
.pill.tp { color: var(--green); border-color: rgba(25,210,122,.4); }
.scorebar { display: flex; align-items: center; gap: 8px; margin-top: 8px; font-family: var(--mono); font-size: 12px; }
.scorebar .track { flex: 1; height: 8px; background: #11151c; border-radius: 2px; position: relative; overflow: visible; }
.scorebar .fill { height: 100%; background: var(--green); border-radius: 2px; }
.scorebar .min { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--amber); }

/* auditor layers */
.layers { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
.layer { background: var(--panel); padding: 7px 9px; border-left: 3px solid var(--dim); }
.layer.ok { border-left-color: var(--green); } .layer.red { border-left-color: var(--red); }
.layer .n { font-size: 11px; color: var(--muted); }
.layer .v { font-family: var(--mono); font-size: 12px; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.layer.red .v { color: var(--red); } .layer.ok .v { color: var(--green); }

/* settings */
.setrow { display: flex; justify-content: space-between; gap: 10px; padding: 7px 10px; border-top: 1px solid var(--line); font-size: 12.5px; }
.setrow:first-child { border-top: 0; }
.setrow .k { color: var(--muted); }
.setrow .k small { color: var(--dim); font-family: var(--mono); font-size: 10px; margin-left: 4px; }
.setrow .v { font-family: var(--mono); font-variant-numeric: tabular-nums; text-align: right; word-break: break-all; }
.infop { padding: 10px; font-size: 12.5px; }
.infop p { margin: 6px 0 0; color: var(--muted); }

h1.screen { font-family: var(--mono); font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--amber); margin: 6px 2px 8px; }
.back { font-family: var(--mono); font-size: 12px; color: var(--cyan); padding: 6px 2px; }

/* tab bar */
.tabs { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; background: rgba(5,6,8,.96);
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-top: 1px solid var(--line); padding-bottom: var(--safe-bot); }
.tabs nav { max-width: 520px; margin: 0 auto; display: grid; grid-template-columns: repeat(5, 1fr); height: var(--tab-h); }
.tabs button { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: var(--dim);
  font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; position: relative; }
.tabs button svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.8; }
.tabs button.on { color: var(--amber); }
.tabs button.on::before { content: ""; position: absolute; top: 0; left: 28%; right: 28%; height: 2px; background: var(--amber); }

/* access screen */
.gate { padding: calc(var(--safe-top) + 32px) 18px 24px; max-width: 520px; margin: 0 auto; }
.gate .logo { font-size: 15px; }
.gate h1 { font-size: 20px; margin: 18px 0 6px; }
.gate p { color: var(--muted); margin: 0 0 16px; }
.gate input { width: 100%; height: 46px; border-radius: 5px; border: 1px solid var(--line2); background: var(--panel); color: var(--text); padding: 0 12px; font: 15px var(--mono); }
.gate button { margin-top: 10px; width: 100%; height: 46px; border-radius: 5px; background: var(--amber); color: #000; font: 700 14px var(--mono); letter-spacing: .1em; }

/* ================= olli81 · v5 professional layer ================= */
body { background: radial-gradient(1200px 500px at 50% -200px, rgba(34,211,127,.07), transparent 60%), var(--bg); }
.sbar { background: rgba(7,9,13,.9); }
.sbar .r1 { padding: 10px 12px 8px; gap: 7px; }
.logo { display: inline-flex; align-items: center; gap: 7px; font-family: var(--sans); font-weight: 800; font-size: 16px; letter-spacing: -.01em; color: var(--text); text-transform: none; }
.logo b { color: var(--brand); font-weight: 800; }
.logo .mk { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 7px;
  background: linear-gradient(135deg, #22d37f, #0fa3b1); color: #04120b; font-family: var(--mono); font-size: 11px; font-weight: 900; letter-spacing: 0; }
.logo.big { font-size: 26px; } .logo.big .mk { width: 36px; height: 36px; font-size: 15px; border-radius: 10px; }
.mode { border-radius: 999px; padding: 3px 9px; font-size: 10.5px; }
.spill { display: inline-flex; align-items: center; gap: 5px; font-family: var(--mono); font-size: 10.5px; padding: 3px 8px; border-radius: 999px;
  border: 1px solid var(--line2); color: var(--muted); white-space: nowrap; }
.spill.ok { color: var(--green); border-color: rgba(34,211,127,.35); background: var(--green-bg); }
.spill.warn { color: var(--amber); border-color: rgba(245,181,61,.4); }
.spill.bad { color: var(--red); border-color: rgba(255,84,104,.45); background: var(--red-bg); }
.upd { font-size: 10.5px; }
@media (max-width: 380px) { .upd #updTxt { display: none; } .spill { font-size: 10px; padding: 2px 6px; } }
.tick .v { font-size: 15px; }
.sec h2 { font-family: var(--sans); font-size: 12px; letter-spacing: .08em; color: var(--muted); font-weight: 750; }
.sec { margin: 20px 2px 8px; }
h1.screen { font-family: var(--sans); font-size: 22px; letter-spacing: -.01em; text-transform: none; color: var(--text); font-weight: 800; margin: 8px 2px 10px; }
.panel, .tape, .kpis, .posc, .ag, .layers, .empty, .note, .error { border-radius: var(--r); }
.kpi .v.big { font-size: 21px; }
.posc, .ag, .tape, .panel { box-shadow: 0 1px 0 rgba(255,255,255,.02) inset, 0 8px 24px rgba(0,0,0,.25); }
.btn { border-radius: 9px; height: 40px; }
.btn.sm { height: 34px; font-size: 11.5px; }
.btn.buy { background: var(--green); border-color: var(--green); color: #03140b; }
.tag { border-radius: 999px; padding: 1px 7px; }
.tag.dip { color: var(--violet); border-color: rgba(155,123,255,.5); }
.tag.neu { color: var(--cyan); border-color: rgba(63,213,230,.45); }
.amb { color: var(--amber); }
.lnkb { color: var(--cyan) !important; font-weight: 700; }
.tabs nav button { font-size: 10px; }

/* percent bars */
.pbar, .segbar { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
.pbar .trk { flex: 1; height: 8px; border-radius: 999px; background: #161c26; overflow: hidden; }
.pbar .fil { height: 100%; border-radius: 999px; background: var(--dim); transition: width .4s; }
.fil.g, .sf.g { background: linear-gradient(90deg, #17b46b, #22d37f); }
.fil.a, .sf.a { background: linear-gradient(90deg, #d4942a, #f5b53d); }
.fil.o { background: var(--orange); } .fil.r { background: var(--red); } .fil.b { background: var(--blue); } .fil.d { background: #3a4456; }
.pv { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 12px; font-weight: 700; min-width: 42px; text-align: right; }
.segbar .sgs { flex: 1; display: flex; gap: 3px; }
.segbar .sg { height: 8px; border-radius: 3px; background: #161c26; overflow: hidden; }
.segbar .sf { height: 100%; background: #4a5568; }
.segbar .sf.g { background: linear-gradient(90deg, #17b46b, #22d37f); }
.segbar .sf.a { background: linear-gradient(90deg, #d4942a, #f5b53d); }

/* favourites */
.fav { background: linear-gradient(180deg, #111720, var(--panel)); border: 1px solid var(--line); border-radius: var(--r); padding: 11px 12px 12px; }
.fav + .fav { margin-top: 8px; }
.fh { display: flex; align-items: center; gap: 10px; }
.rk { flex: none; width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center;
  font-family: var(--mono); font-weight: 800; font-size: 13px; background: var(--panel2); border: 1px solid var(--line2); color: var(--amber); }
.fav:nth-child(-n+3) .rk { }
.fm { min-width: 0; flex: 1; }
.fm .nm, .pr1 .nm { font-weight: 700; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fm .nm a, .pr1 .nm a { color: var(--text); }
.fs { text-align: right; } .fs .v { font-family: var(--mono); font-size: 22px; font-weight: 800; color: var(--green); line-height: 1; }
.fl { margin-top: 10px; } .fl .lbl { display: block; }
.fl .segbar { margin-top: 4px; }
.chips { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 9px; }
.chip { font-size: 11px; padding: 3px 8px; border-radius: 999px; background: var(--panel2); border: 1px solid var(--line2); color: #c3cad6; }
.lnk2 { display: flex; gap: 8px; margin-top: 10px; }
.hp { font-family: var(--mono); font-size: 9.5px; font-weight: 800; letter-spacing: .06em; padding: 2px 7px; border-radius: 999px; margin-left: 6px; vertical-align: 2px; border: 1px solid; }
.hp.hy { color: var(--green); border-color: rgba(34,211,127,.5); background: var(--green-bg); }
.hp.ne { color: var(--muted); border-color: var(--line2); }
.hp.sh { color: var(--red); border-color: rgba(255,84,104,.5); background: var(--red-bg); }

/* progress cards */
.prog, .hyc { display: block; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r); padding: 10px 12px; }
.prog + .prog, .hyc + .hyc { margin-top: 8px; }
.prog summary { list-style: none; cursor: pointer; }
.prog summary::-webkit-details-marker { display: none; }
.pr1 { display: flex; align-items: center; gap: 8px; }
.pr1 .nm { flex: 1; min-width: 0; }
.stg { font-family: var(--mono); font-size: 10px; color: var(--muted); border: 1px solid var(--line2); border-radius: 999px; padding: 2px 8px; white-space: nowrap; }
.steps { margin-top: 8px; border-top: 1px solid var(--line); }
.st { display: grid; grid-template-columns: 1.1fr 1.4fr 46px; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 12px; }
.st .sl { color: var(--muted); } .st .sd { font-family: var(--mono); font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.st .sp { font-family: var(--mono); text-align: right; font-weight: 700; }
.hyc.hy { border-left: 3px solid var(--green); } .hyc.sh { border-left: 3px solid var(--red); } .hyc.ne { border-left: 3px solid var(--line2); }
.hyc .grid4 small { font-size: 10px; }
.legendp { padding: 10px 12px; font-size: 12px; color: var(--muted); }
.legendp summary { cursor: pointer; color: var(--cyan); font-weight: 700; font-size: 12.5px; }
.legendp p { margin: 8px 0 0; line-height: 1.45; } .legendp b { color: var(--text); }
.tr.sig { grid-template-columns: 40px 54px 1fr auto; }

/* ===== 1945f: video typography on all pages (typography only; layout/colors unchanged) ===== */
:root {
  --sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", Inter, "Helvetica Neue", Arial, sans-serif;
  --tagmono: ui-monospace, "SF Mono", Menlo, monospace;
  /* text that used the old mono font now uses the video font */
  --mono: var(--sans);
}
html, body { font-family: var(--sans); font-variant-numeric: tabular-nums; }
.num, .mono, .tick .v, .kpi .v, .kpi .s, .grid4 .v, .tr .r, .tb .rt, .bar .x, .setrow .v, .pv, .fs .v, .st .sp, .ph .pnl, .ag .big { font-variant-numeric: tabular-nums; }
/* small tags / pills stay monospace like in the video */
.tag, .pill, .tr .k, .hp, .stg, .tpbar span, .mode, .spill, code, .setrow .k small { font-family: var(--tagmono); }

/* ===== desk animations: 60fps (transform/opacity), reduced-motion aware ===== */
@keyframes desk-in {
  from { opacity: 0; transform: translate3d(0, 10px, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}
@keyframes row-in {
  from { opacity: 0; transform: translate3d(0, -10px, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}
@keyframes flash-up {
  0% { background-color: rgba(48, 209, 88, .28); }
  100% { background-color: transparent; }
}
@keyframes flash-dn {
  0% { background-color: rgba(255, 69, 58, .28); }
  100% { background-color: transparent; }
}
@keyframes livepulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .45; transform: scale(.85); }
}
@keyframes liveglow {
  0% { box-shadow: 0 0 0 0 rgba(48, 209, 88, .42); }
  70% { box-shadow: 0 0 0 8px rgba(48, 209, 88, 0); }
  100% { box-shadow: 0 0 0 0 rgba(48, 209, 88, 0); }
}

.desk-in {
  animation: desk-in .45s cubic-bezier(.22, 1, .36, 1) both;
  animation-delay: calc(var(--i, 0) * 40ms);
}
.is-new { animation: row-in .42s cubic-bezier(.22, 1, .36, 1) both; }

.tick-up, .tick-dn { border-radius: 8px; }
.tick-up { animation: flash-up .7s ease-out; }
.tick-dn { animation: flash-dn .7s ease-out; }

/* LIVE badges / dots: pulse + soft glow */
.bn .d.ok {
  animation: livepulse 1.6s ease-in-out infinite;
}
/* header / status-bar dots: crisp on/off blink */
@keyframes blink-dot {
  0%, 45% { opacity: 1; }
  55%, 100% { opacity: .08; }
}
.sbar .dot.ok, .sbar .dot.warn, .sbar .dot.bad,
.spill .dot, .spill.ok .dot, .spill.warn .dot, .spill.bad .dot,
#updDot.ok, #updDot.warn, #updDot.bad,
.mode.LIVE::before {
  animation: blink-dot 1s step-end infinite;
}
.mode.LIVE { animation: liveglow 2.2s ease-out infinite; }
.mbadge.live {
  box-shadow: 0 0 10px rgba(48, 209, 88, .28);
}
.mbadge.live::before {
  content: "";
  display: inline-block;
  width: 6px; height: 6px; border-radius: 50%;
  background: currentColor;
  margin-right: 5px;
  vertical-align: 1px;
  animation: livepulse 1.4s ease-in-out infinite;
}

/* open-position PnL bar (scaleX only) */
.pnlbar {
  position: relative;
  height: 3px;
  margin-top: 7px;
  background: rgba(255, 255, 255, .07);
  border-radius: 99px;
  overflow: hidden;
}
.pnlbar i {
  position: absolute;
  top: 0; bottom: 0;
  width: 50%;
  display: block;
  transform: scaleX(0);
  transition: transform .5s cubic-bezier(.22, 1, .36, 1);
  border-radius: 99px;
  background: #8e8e93;
}
.pnlbar.up i { left: 50%; transform-origin: left center; background: #30d158; }
.pnlbar.dn i { right: 50%; left: auto; transform-origin: right center; background: #ff453a; }
.cpos { flex-wrap: wrap; }
.cpos .pnlbar { flex: 1 0 100%; margin-top: 6px; }

/* hover (pointer) + tap/press feedback */
.pressable, .btn, .brow, .cpos, .trow, .posc, .tr, .tabs button, .tranges button,
.chip, .cpbtn, .more, .gate button, .cpsw, .panel.copyp a, .ccard {
  -webkit-tap-highlight-color: transparent;
}
.btn, .brow, .cpos, .trow, .posc, .tr, .tabs button, .tranges button,
.chip, .cpbtn, .more, .gate button, .ccard, .cpcard, .ag, .panel {
  transition: transform .15s ease, opacity .15s ease;
}
@media (hover: hover) and (pointer: fine) {
  .btn:hover, .cpbtn:hover, .chip:hover, .tranges button:hover, .more:hover, .gate button:hover {
    transform: translateY(-1px);
  }
  .brow:hover, .cpos:hover, .trow:hover, .posc:hover, .tr:hover, .ccard:hover, .cpcard:hover {
    transform: translateY(-1px);
  }
  .tabs button:hover { opacity: .82; }
}
.btn:active, .brow:active, .cpos:active, .trow:active, .posc:active, .tr:active,
.tabs button:active, .tranges button:active, .chip:active, .cpbtn:active,
.more:active, .gate button:active, .ccard:active, .pressable.is-press {
  transform: scale(.97);
}

@media (prefers-reduced-motion: reduce) {
  .desk-in, .is-new, .tick-up, .tick-dn,
  .bn .d.ok,
  .sbar .dot.ok, .sbar .dot.warn, .sbar .dot.bad,
  .spill .dot, #updDot, .mode.LIVE, .mode.LIVE::before,
  .mbadge.live, .mbadge.live::before,
  .lpill.on, .lpill.on i,
  .brow.is-live .d, .brow.is-run .bav, .brow.is-run .bav .sring,
  .ag.is-run .ic, .ag.is-run .ic .sring, .hb-tick,
  .foll .fav, .layer.ok, .brow.is-run .bm .scan,
  .pring .arc {
    animation: none !important;
  }
  .desk-in, .is-new, .btn, .brow, .cpos, .trow, .posc, .tr, .tabs button,
  .tranges button, .chip, .cpbtn, .more, .gate button, .ccard, .cpcard, .ag, .panel, .pnlbar i, .pring .arc {
    transition: none !important;
  }
  .btn:hover, .brow:hover, .cpos:hover, .trow:hover, .posc:hover, .tr:hover,
  .btn:active, .brow:active, .cpos:active, .trow:active, .posc:active, .pressable.is-press {
    transform: none !important;
  }
}


/* ===== bot / agent / ring animations ===== */
@keyframes botbreath {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
@keyframes botsweep {
  to { transform: rotate(360deg); }
}
@keyframes scanlight {
  0% { transform: translateX(-130%); opacity: 0; }
  18% { opacity: .4; }
  100% { transform: translateX(160%); opacity: 0; }
}
@keyframes hbtick {
  0% { transform: scale(1); }
  30% { transform: scale(1.85); }
  100% { transform: scale(1); }
}
@keyframes layeron {
  from { opacity: .4; }
  to { opacity: 1; }
}
@keyframes layerflow {
  0%, 100% { background-color: transparent; }
  35% { background-color: rgba(34, 211, 127, .14); }
}
@keyframes layerflow-bad {
  0%, 100% { background-color: transparent; }
  35% { background-color: rgba(255, 69, 58, .12); }
}

/* percentage rings */
.crings { display: flex; justify-content: space-around; align-items: flex-start; gap: 8px; margin: 12px 0 4px; }
.crings.one { justify-content: flex-start; align-items: center; gap: 20px; padding: 0 4px; }
.crings.one .cside { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.crings.one .cside .cl2 { display: block; font-size: 12px; color: #8e8e93; font-weight: 500; }
.crings.one .cside .cs { font-size: 17px; font-weight: 600; font-variant-numeric: tabular-nums; color: #fff; }
.pring { position: relative; width: 72px; flex: 0 0 auto; text-align: center; }
.pring svg { width: 72px; height: 72px; display: block; transform: rotate(-90deg); }
.pring .track, .pring .arc {
  fill: none;
  stroke-width: 2.6;
  stroke-linecap: round;
}
.pring .track { stroke: rgba(255, 255, 255, .08); }
.pring .arc {
  stroke: var(--ring, #8e8e93);
  stroke-dasharray: var(--p, 0) 100;
  transition: stroke-dasharray .7s cubic-bezier(.22, 1, .36, 1), stroke .45s ease;
}
.pring.tone-g { --ring: #30d158; }
.pring.tone-a { --ring: #ffd60a; }
.pring.tone-r { --ring: #ff453a; }
.pring.tone-b { --ring: #5ac8fa; }
.pring.tone-m { --ring: #636366; }
.pring .pc {
  position: absolute; left: 0; right: 0; top: 0;
  height: 72px; display: flex; flex-direction: column; align-items: center; justify-content: center;
  pointer-events: none; line-height: 1.05;
}
.pring .pn { font-weight: 700; font-size: 15px; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
.pring.tone-g .pn { color: #30d158; }
.pring.tone-a .pn { color: #ffd60a; }
.pring.tone-r .pn { color: #ff453a; }
.pring.tone-b .pn { color: #5ac8fa; }
.pring .pc small { font-size: 9px; color: #8e8e93; font-weight: 600; margin-top: 1px; }
.pring .pl { margin-top: 5px; font-size: 11px; color: #8e8e93; font-weight: 500; }
.pring.nolab { margin-bottom: 0; }
.kpi .pring { width: 64px; margin: 4px auto 0; }
.kpi .pring svg, .kpi .pring .pc { width: 64px; height: 64px; }
.kpi .pring .pn { font-size: 13.5px; }
.kpi .v.ringed { overflow: visible; white-space: normal; }

/* agent cards: status ring + run/idle */
.ag { position: relative; }
.ag .ic { position: relative; overflow: visible; }
.ag .ic .sring {
  position: absolute; inset: -4px; width: calc(100% + 8px); height: calc(100% + 8px);
  pointer-events: none;
}
.ag .ic .sring circle {
  fill: none; stroke: var(--cyan, #3fd5e6); stroke-width: 1.8;
  stroke-dasharray: 20 80; stroke-linecap: round; opacity: .7;
}
.ag.is-run .ic { animation: botbreath 3s ease-in-out infinite; }
.ag.is-run .ic .sring { animation: botsweep 2.6s linear infinite; }
.ag.is-idle .ic .sring { opacity: .25; animation: none; }
.ag.is-idle .ic .sring circle { stroke-dasharray: 100 0; }
.ag.is-paused { opacity: .62; }
.ag.is-paused .ic .sring { display: none; }
.hb-tick { animation: hbtick .45s ease-out; }

/* pipeline layers: sequential light */
.layer { position: relative; }
.layer.ok {
  animation: layeron .4s ease both, layerflow 2.8s ease-in-out infinite;
  animation-delay: calc(var(--li, 0) * .12s), calc(.45s + var(--li, 0) * .28s);
}
.layer.red {
  animation: layeron .4s ease both, layerflow-bad 2.8s ease-in-out infinite;
  animation-delay: calc(var(--li, 0) * .12s), calc(.45s + var(--li, 0) * .28s);
}

/* followed-trader chips */
.foll { display: inline-flex; align-items: center; gap: 6px; }
a.foll { color: inherit; text-decoration: none; transition: transform .15s ease, opacity .15s ease; }
a.foll:active, a.foll.is-press { transform: scale(.97); }
@media (hover: hover) and (pointer: fine) {
  a.foll:hover { transform: translateY(-1px); opacity: .92; }
}
.foll .fav, .cpcard .fav {
  flex: none; width: 22px; height: 22px; border-radius: 50%;
  display: inline-grid; place-items: center;
  background: #2c2c2e; color: #e9edf3; font-size: 9px; font-weight: 700;
  box-shadow: 0 0 0 1px rgba(90, 200, 250, .4);
  animation: livepulse 2s ease-in-out infinite;
}
.foll.old .fav, .cpcard.old .fav { animation: none; opacity: .55; box-shadow: 0 0 0 1px rgba(255,255,255,.12); }
.cph { align-items: center; }
.cph .fav { margin-right: 2px; }

@media (prefers-reduced-motion: reduce) {
  .ag.is-run .ic, .ag.is-run .ic .sring, .layer.ok, .layer.red, .foll .fav, .cpcard .fav, .hb-tick,
  .sbar .dot.ok, .sbar .dot.warn, .sbar .dot.bad, .spill .dot, #updDot, .mode.LIVE::before {
    animation: none !important;
  }
}
